


monitor = ,preferred,auto,1 

exec-once = waybar
exec-once = hyprpaper 

input {
    kb_layout = uk
  }

general {
    gaps_in = 5
    gaps_out = 10
    border_size=  2
  }

bind = SUPER, RETURN, exec, kitty
bind = SUPER, Q, killactive
bind = SUPER, M, exit
bind = SUPER, D, exec, wofi --show drun 


